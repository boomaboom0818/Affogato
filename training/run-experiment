#!/usr/bin/env bash
# Bound the entire job with systemd RuntimeMaxSec (see README).
set -euo pipefail
cd "$(dirname "$0")/.."
run=$1
if [[ ${2:-} == --from-data ]]; then
    test -d "$run"
    test ! -e "$run/affogato-002"
else
    mkdir "$run"
    git rev-parse HEAD > "$run/revision"
    date -Is >> "$run/run.log"
    echo 'Generating 9x9 search targets for five hours' >> "$run/run.log"
    start=$SECONDS
    rc=0
    timeout --signal=INT --kill-after=90s 5h training/selfplay 100000 1536 > "$run/selfplay.log" 2>&1 || rc=$?
    # The AppImage wrapper can exit 137 when the allotted collection time expires.
    if [[ $rc != 0 && $rc != 124 ]] && ! [[ $rc == 137 && $((SECONDS-start)) -ge 18000 ]]; then
        exit "$rc"
    fi
fi
exec >>"$run/run.log" 2>&1
date -Is
echo 'Fitting a frozen candidate'
.runtime/venv/bin/python training/fit.py "$run/affogato-002" > "$run/fit.log" 2>&1
date -Is
echo 'Sampling 64 evaluation openings'
python3 training/openings.py --count 64 > "$run/openings.json" 2> "$run/openings.log"
date -Is
echo 'Playing 128 games with five seconds per move'
python3 training/arena.py "$run/affogato-002/model.bin.gz" --openings "$run/openings.json" --pairs 64 > "$run/games.jsonl" 2> "$run/arena.log"
python3 training/report.py "$run/games.jsonl" --expected-pairs 64 | tee "$run/result.json"
date -Is
